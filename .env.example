# =============================================================================
# Droit — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=droit
POSTGRES_PASSWORD=droit_secret
POSTGRES_DB=droit_db
DROIT_DATABASE_URL=postgresql+asyncpg://droit:droit_secret@localhost:5432/droit_db

# ── Qdrant ─────────────────────────────────────────────────────────────────
DROIT_QDRANT_URL=http://localhost:6333
DROIT_QDRANT_COLLECTION=droit_legal_documents

# ── Redis (Phase 4) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth (NextAuth / Backend JWT) ────────────────────────────────────────────
NEXTAUTH_SECRET=change_me_in_production_use_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
DROIT_AUTH_REQUIRED=false
DROIT_JWT_SECRET=change_me_in_production

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Default provider: groq | openai | anthropic | ollama
DROIT_LLM_PROVIDER=groq
DROIT_LLM_MODEL=llama-3.3-70b-versatile
DROIT_LLM_API_KEY=
# Set for Ollama or an OpenAI-compatible custom endpoint.
DROIT_LLM_BASE_URL=
DROIT_LLM_TIMEOUT_SECONDS=60
DROIT_LLM_MAX_TOKENS=1024

# ── Embedding ──────────────────────────────────────────────────────────────────
DROIT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DROIT_RETRIEVAL_CANDIDATE_LIMIT=30
DROIT_RETRIEVAL_VECTOR_WEIGHT=1.0
DROIT_RETRIEVAL_BM25_WEIGHT=1.0
DROIT_RETRIEVAL_RRF_K=60
DROIT_RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DROIT_RETRIEVAL_RERANKER_CANDIDATE_LIMIT=12

# ── Storage (local disk) ──────────────────────────────────────────────────────
DROIT_STORAGE_ROOT=./storage
DROIT_MAX_UPLOAD_BYTES=26214400
# Required in production. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DROIT_PII_ENCRYPTION_KEY=

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
DROIT_ENVIRONMENT=development
DROIT_DEBUG=false

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
