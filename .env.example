# =============================================================================
# Droit — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=droit
POSTGRES_PASSWORD=droit_secret
POSTGRES_DB=droit_db
DATABASE_URL=postgresql+asyncpg://droit:droit_secret@localhost:5432/droit_db
DATABASE_URL_SYNC=postgresql://droit:droit_secret@localhost:5432/droit_db

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=droit_legal_docs

# ── Redis (Phase 4) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth (NextAuth / Backend JWT) ────────────────────────────────────────────
NEXTAUTH_SECRET=change_me_in_production_use_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=change_me_in_production

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Default provider: groq | openai | anthropic | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (app-level, local LLM — data never leaves your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embedding ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── Storage (local disk) ──────────────────────────────────────────────────────
STORAGE_ROOT=./storage/uploads

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
